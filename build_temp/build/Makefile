	$(MAKE) $(MAKESILENT) -f CMakeFiles/jinwo.dir/build.make CMakeFiles/jinwo.dir/src/jw_vecdb.c.s
.PHONY : src/jw_vecdb.c.s

src/jw_vector.o: src/jw_vector.c.o
